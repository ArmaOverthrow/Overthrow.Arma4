   Id "OVT-Job_PlaceCamp"
   Target_en_us "Tutorial - Place a camp"
   Target_de_de "Tutorial – Ein Camp errichten"
   Target_ru_ru "Обучение — Разместите лагерь"
   Target_uk_ua "Навчання - Розмістіть табір"
